{
  "schemaVersion": 1,
  "id": "${id}",
  "name": "${name}",
  "version": "${version}",
  "authors": ["${authors}"],
  "contributors": ["${contributors}"],
  "contact": {
    "sources": "${sources_url}",
    "issues": "${issues_url}",
    "homepage": "${homepage_url}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.donate": "${donate_url}",
        "modmenu.modrinth": "https://modrinth.com/mod/${modrinth_id}",
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/${curseforge_slug}",
        "modmenu.youtube": "${youtube_url}"
      }
    },
    "catalogue": {
      "banner": "icon.png"
    }
  },
  "description": "${description}",
  "icon": "icon.png",
  "license": "${license}",
  "environment": "*",
  "accessWidener": "aw/${minecraft}.accesswidener",
  "entrypoints": {
    "main": [
      "${group}.${id}.platform.fabric.FabricEntrypoint"
    ]
  },
  "mixins": [
    "${id}.mixins.json"
  ],${dependencies}
}
